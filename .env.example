# Get these from https://my.telegram.org
VITE_TELEGRAM_API_ID=
VITE_TELEGRAM_API_HASH=

# Optional: true = mock Telegram (UI tests), false = real. Blank = auto
# (real when the credentials above are set, mock otherwise).
VITE_USE_MOCK_ADAPTER=

# Optional: real-Telegram Playwright tests in tests/real (run with REAL_TG=1).
TG_PHONE=
TG_GROUP=
